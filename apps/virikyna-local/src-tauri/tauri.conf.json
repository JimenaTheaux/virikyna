{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virikyna Local",
  "version": "0.2.0",
  "identifier": "com.virikyna.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Virikyna Local",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1NjcwNzYxREJCMkVGQ0YKUldUUDc3TGJZUWRudFNaMm9YczJVOVJCRnB3TkdCeFRRWEtkcjV2TEZPbUtMYmYreTdCd1lhbjEK",
      "endpoints": [
        "https://github.com/JimenaTheaux/virikyna/releases/latest/download/latest.json"
      ]
    }
  }
}
